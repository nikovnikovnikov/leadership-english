# Supabase — create a project at https://supabase.com and copy these from
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Used by the Stripe webhook (server-only). Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe — create keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe prices — create Products + Prices in the Stripe Dashboard, then paste
# the Price IDs here. At least one is required if ENABLE_STRIPE=true.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# The absolute URL of your app (used for Stripe redirects, email links, manifest).
# MUST be set to your production domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true once you have configured Stripe checkout + prices.
# When false, all lessons are unlocked without a subscription (free mode).
ENABLE_STRIPE=false

# Create an admin account, then set this to that user's UUID to force admin role.
# Leave blank to auto-promote the first user who completes /setup.
ADMIN_USER_IDS=

# Email notifications — optional. Get a free API key at https://resend.com
# You must verify your sending domain in Resend before emails will deliver.
RESEND_API_KEY=
FROM_EMAIL=Sanctum <notifications@yourdomain.com>
